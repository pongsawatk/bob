# BOB Sidekick — Environment Variables (v2)
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ถูก gitignore ไว้แล้ว ห้าม commit)
# วิธีหา key แต่ละตัว ดู docs/phase-0-setup.md

# ── OpenRouter (LLM gateway: Gemini + Claude) ──────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# slug ของ Product model — ดูชื่อจริงที่ https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# ── Langfuse (prompt management + observability) ───────────────────
# Cloud free: สมัครที่ https://cloud.langfuse.com → Project → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Upstash Redis (bundle cache สำหรับ Vercel stateless) ────────────
# สมัครที่ https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://xxxx-xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Outline (knowledge source — ใช้จริงตอน Phase 2) ─────────────────
OUTLINE_BASE_URL=https://outline.builk.id
OUTLINE_API_TOKEN=ol_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# id ของ collection ที่ให้ bot อ่าน (คั่นด้วย comma) — เติมตอน Phase 2
OUTLINE_COLLECTION_IDS=

# ── Azure Bot (MS Teams — ใช้จริงตอน Phase 1 ปลายๆ/Phase 3) ─────────
AZURE_BOT_ID=
AZURE_BOT_SECRET=
AZURE_TENANT_ID=
