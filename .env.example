# BOB Sidekick — Environment Variables (v2)
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ถูก gitignore ไว้แล้ว ห้าม commit)
# วิธีหา key แต่ละตัว ดู docs/phase-0-setup.md

# ── OpenRouter (LLM gateway — 1 key ใช้ได้ทุก model) ───────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model ต่อ tier — ดู slug จริงที่ https://openrouter.ai/models
# Tier 1: Router — classify HR/PRODUCT/GENERAL/UNKNOWN (ไม่ต้อง nuance, เร็ว+ถูก)
MODEL_ROUTER=google/gemini-3.1-flash-lite

# Tier 2: HR Bot — ตอบเรื่อง HR/สวัสดิการ/Process (ข้อมูลพนักงาน = risk จริง ต้องแม่น)
MODEL_HR=anthropic/claude-sonnet-4-6

# Tier 3: General Bot — clarify/redirect เท่านั้น ไม่ได้ให้ข้อมูลสำคัญ
MODEL_GENERAL=google/gemini-3.1-flash-lite

# Tier 4: Product Bot — ตอบเรื่อง Product (quality-first, nuance ภาษาไทย)
MODEL_PRODUCT=anthropic/claude-sonnet-4-6

# Tier 5: Async/Eval — งาน batch ไม่ realtime (KB summary, FAQ gen, eval scoring)
# DeepSeek V4 Flash: benchmark ดีกว่า Haiku 4.5 + ถูกกว่า ~10x ($0.14/$0.28 per M)
MODEL_ASYNC=deepseek/deepseek-v4-flash

# ── Langfuse (prompt management + observability) ───────────────────
# Cloud free: สมัครที่ https://cloud.langfuse.com → Project → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Upstash Redis (bundle cache สำหรับ Vercel stateless) ────────────
# สมัครที่ https://console.upstash.com → Create Database → REST API
# (Phase 2 — เว้นว่างได้ตอน Phase 1)
UPSTASH_REDIS_REST_URL=https://xxxx-xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Outline (knowledge source — ใช้จริงตอน Phase 2) ─────────────────
OUTLINE_BASE_URL=https://outline.builk.id
OUTLINE_API_TOKEN=ol_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# id ของ collection ที่ให้ bot อ่าน (คั่นด้วย comma) — "BOB Knowledge Base"
OUTLINE_COLLECTION_IDS=dab98231-5cc8-4805-9dcd-7e447a292398

# ── KB admin (สิทธิ์สั่ง /refresh ใน Teams) ─────────────────────────
# อีเมลผู้ดูแลที่กดอัปเดตความรู้จาก Outline ได้ (คั่นด้วย comma)
KB_ADMIN_EMAILS=pongsawat@builk.com,bhoomchai@builk.com

# ── Azure Bot (MS Teams — ใช้จริงตอน Phase 1 ปลาย) ──────────────────
AZURE_BOT_ID=
AZURE_BOT_SECRET=
AZURE_TENANT_ID=
