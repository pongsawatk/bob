{
  "name": "bob-sidekick",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "BOB Sidekick — Builk One Bot (v2: TypeScript service + Outline + Langfuse, deployed on Vercel)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-connectivity.mjs",
    "verify:cache": "node scripts/verify-cache-control.mjs",
    "smoke": "node scripts/run-smoke.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "botbuilder": "^4.23.1",
    "langfuse": "^3.37.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/node": "^5.8.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
