{
  "name": "bob-sidekick",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "BOB Sidekick — Builk One Buddy (v2: TypeScript service + Outline + Langfuse, deployed on Vercel)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-connectivity.mjs",
    "refresh-kb": "tsx scripts/refresh-kb.ts",
    "seed-prompts": "node scripts/seed-prompts.mjs",
    "verify:cache": "node scripts/verify-cache-control.mjs",
    "smoke": "node scripts/run-smoke.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "insight:report": "tsx scripts/insight-report.mjs",
    "prompt": "node scripts/prompt-admin.mjs"
  },
  "dependencies": {
    "@langfuse/client": "^5.10.1",
    "@langfuse/otel": "^5.10.1",
    "@langfuse/tracing": "^5.10.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@upstash/qstash": "^2.11.1",
    "@upstash/redis": "^1.34.3",
    "@vercel/functions": "^3.7.5",
    "botbuilder": "^4.23.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/node": "^22.10.0",
    "@vercel/node": "^5.8.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
